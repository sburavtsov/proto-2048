{
    "configurations": [

        {
            "name": "Unit tests",
            "type": "lua-local",
            "request": "launch",
            "verbose": true,
            "program": {
                "command": "${workspaceFolder}/deftest/run.sh"
            },
            "args": ["arm64-macos"]
        },
        
        {
            "name": "DT Launch",
            "type": "lua",
            "request": "launch",
            "stopOnEntry": true,
            "runtimeExecutable": "luajit",
            "runtimeArgs": "${workspaceFolder}/test/test.lua",
            "inject": "none",
            "address": "127.0.0.1:12306"
        },
        {
            "type": "lua-local",
            "request": "launch",
            "name": "DefTest",
            "program": {
                "command": "luajit"
            },
            "args": ["${workspaceFolder}/test/test.lua"],
            "scriptRoots": ["."]
        },

        {
            "name": "Defold Kit",
            "type": "lua-local",
            "request": "launch",
            "stopOnEntry": false,
            "verbose": false,
            "internalConsoleOptions": "openOnSessionStart",
            "program": {
                "command": "build/defoldkit/dmengine"
            },
            "args": [
                "build/defoldkit/game.projectc"
            ],
            "windows": {
                "program": {
                    "command": "build\\defoldkit\\dmengine.exe"
                },
                "args": [
                    "build\\defoldkit\\game.projectc"
                ]
            },
            "preLaunchTask": "Defold Kit: Build to Launch"
        }
    ]
}