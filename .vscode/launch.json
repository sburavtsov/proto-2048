{
    "configurations": [

        {
    "name": "Unit tests",
    "type": "lua-local",
    "request": "launch",
    "verbose": true,
    "program": {
        "command": "${workspaceFolder}/deftest/run.sh"
    },
    "args": ["arm64-macos"]
},

        {
            "name": "Defold Kit",
            "type": "lua-local",
            "request": "launch",
            "stopOnEntry": false,
            "verbose": false,
            "internalConsoleOptions": "openOnSessionStart",
            "program": {
                "command": "build/defoldkit/dmengine"
            },
            "args": [
                "build/defoldkit/game.projectc"
            ],
            "windows": {
                "program": {
                    "command": "build\\defoldkit\\dmengine.exe"
                },
                "args": [
                    "build\\defoldkit\\game.projectc"
                ]
            },
            "preLaunchTask": "Defold Kit: Build to Launch"
        }
    ]
}