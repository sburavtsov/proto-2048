[bootstrap]
main_collection = /main/main.collectionc

[script]
shared_state = 1

[display]
width = 960
height = 640
high_dpi = 1

[android]
input_method = HiddenInputField

[physics]
gravity_y = -1000.0
scale = 0.01

[html5]
scale_mode = stretch

[project]
title = proto-2048
minimum_log_level = 1
version = 1.01
dependencies#0 = https://github.com/britzl/defold-orthographic/archive/refs/tags/3.6.2.zip
dependencies#1 = https://github.com/britzl/flow/archive/refs/heads/main.zip

